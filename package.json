{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npx concurrently -k \"php artisan serve\" \"npm --prefix frontend run dev\"",
        "api": "php artisan serve",
        "ui": "npm --prefix frontend run dev",
        "ui:build": "npm --prefix frontend run build",
        "build": "vite build"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
